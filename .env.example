# Copie este archivo como .env y complete localmente los valores.
# .env se excluye de Git. No escriba secretos en este archivo de ejemplo.
# Si pega una cadena completa, esta tiene prioridad sobre los campos DB_*.
# Command Timeout no pertenece a la cadena de conexión y debe omitirse.
PROG2_SQL_CONNECTION_STRING=

# Alternativa: configure estos campos para que la aplicación arme la cadena.
# Para SQL Server en Docker con el puerto 1433 publicado use localhost y 1433.
# Para una instancia nombrada de Windows, use por ejemplo .\SQLEXPRESS y deje DB_PORT vacío.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=BD_TelefoniaAccesoriosSA
DB_USER=sa
DB_PASSWORD=

# Supabase: el proyecto compilado es un cliente público.
# Usa únicamente la URL y clave publishable; nunca pongas aquí una secret/service_role key.
SUPABASE_URL=https://zlvjumrwymvoyivhvufy.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_QnDXbogKT6lYUgQ8A1xC4g_mV5cG8OX
